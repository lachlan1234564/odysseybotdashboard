# Secrets and startup values only. Dashboard-managed channels, roles, and branding belong in the database.
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_id
# Optional: preferred server selected when a new dashboard session starts.
DISCORD_GUILD_ID=your_preferred_development_guild_id
DASHBOARD_PASSWORD=choose_a_strong_local_password
DATABASE_URL=file:./data/bot.db
DATABASE_SSL=false
DASHBOARD_PORT=3210
DASHBOARD_HOST=127.0.0.1
UPLOADS_DIR=./uploads
NODE_ENV=development

# Optional: Discord OAuth for the transparent anti-alt verification flow.
# Leave unset to disable verification entirely.
# DISCORD_CLIENT_SECRET=your_oauth_client_secret
# DISCORD_OAUTH_REDIRECT_URI=https://your-domain.example/api/verify/callback
# PUBLIC_BASE_URL=https://your-domain.example

# Optional: VPN/proxy risk provider for verification. Keep both unset to disable.
# Use {ip} where the provider expects the request IP.
# VPN_CHECK_URL_TEMPLATE=https://provider.example/check/{ip}
# VPN_CHECK_API_KEY=your_provider_api_key

# Railway supplies PORT automatically. Do not normally set it for local development.
# PORT=3210

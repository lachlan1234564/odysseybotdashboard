# --- Required for the bot to log in ---
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_id

# Optional: preferred server selected when a new dashboard session starts.
DISCORD_GUILD_ID=your_preferred_development_guild_id

# --- Required for the dashboard login ---
DASHBOARD_PASSWORD=choose_a_strong_local_password

# --- Database (SQLite by default; use a Postgres URL for production) ---
DATABASE_URL=file:./data/bot.db
DATABASE_SSL=false

# --- Dashboard network ---
DASHBOARD_PORT=3210
DASHBOARD_HOST=127.0.0.1
UPLOADS_DIR=./uploads
NODE_ENV=development

# --- Optional: Discord OAuth member verification ---
# Leave DISCORD_CLIENT_SECRET unset to disable verification entirely.
# DISCORD_CLIENT_SECRET=your_oauth_client_secret
# DISCORD_OAUTH_REDIRECT_URI=https://verify.YOUR_DOMAIN.com/api/verify/callback
# VERIFY_PUBLIC_BASE_URL=https://verify.YOUR_DOMAIN.com
# PUBLIC_BASE_URL=https://admin.YOUR_DOMAIN.com

# --- Optional: VPN/proxy risk provider for verification ---
# Leave both unset to skip VPN checks. Use {ip} where the provider expects the request IP.
# VPN_CHECK_URL_TEMPLATE=https://pro.ip-api.com/json/{ip}?fields=proxy,hosting
# VPN_CHECK_API_KEY=your_provider_api_key

# --- Optional: Cloudflare Tunnel / reverse proxy ---
# Set to "true" to trust X-Forwarded-* headers from Cloudflare or a reverse proxy.
# TRUST_PROXY=false

# --- Production: Railway supplies PORT automatically ---
# PORT=3210

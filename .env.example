# CorePanel example environment file.
# Normal public setup is completed in the dashboard at /setup.
# Keep real secrets in Railway variables or a private local .env only.

# --- Required on Railway/production ---
# Used to encrypt stored Discord bot tokens and OAuth secrets.
# Generate with: openssl rand -base64 32
COREPANEL_SECRET_KEY=replace_with_a_long_random_secret

# Railway provides PORT automatically. Local development can use DASHBOARD_PORT.
# PORT=3210
DASHBOARD_PORT=3210
DASHBOARD_HOST=127.0.0.1
NODE_ENV=development
TRUST_PROXY=false

# --- Database ---
# Local default: SQLite.
DATABASE_URL=file:./data/bot.db
DATABASE_SSL=false

# Railway Postgres example:
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL=true

# --- Uploads ---
UPLOADS_DIR=./uploads
# Railway volume example:
# UPLOADS_DIR=/app/uploads

# --- Optional compatibility variables ---
# You can still provide these as Railway variables, but the setup wizard can store them.
# DISCORD_TOKEN=your_bot_token_here
# DISCORD_CLIENT_ID=your_application_id_here
# DISCORD_CLIENT_SECRET=your_oauth_client_secret_here
# DISCORD_GUILD_ID=your_preferred_server_id_here
# DASHBOARD_PASSWORD=temporary_dashboard_password_for_legacy_installs
# PUBLIC_BASE_URL=https://your-app.up.railway.app
# VERIFY_PUBLIC_BASE_URL=https://verify.your-domain.com
# DISCORD_OAUTH_REDIRECT_URI=https://your-app.up.railway.app/api/verify/callback

# --- Optional VPN/proxy provider for verification ---
# VPN_CHECK_URL_TEMPLATE=https://provider.example/check/{ip}
# VPN_CHECK_API_KEY=your_provider_api_key_here

# --- Development/testing ---
# Set to true only when intentionally testing startup without reading a local .env file.
# COREPANEL_DISABLE_DOTENV=true

# Secrets and startup values only. Dashboard-managed channels, roles, and branding belong in the database.
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_id
# Optional: preferred server selected when a new dashboard session starts.
DISCORD_GUILD_ID=your_preferred_development_guild_id
DASHBOARD_PASSWORD=choose_a_strong_local_password
DATABASE_URL=file:./data/bot.db
DATABASE_SSL=false
DASHBOARD_PORT=3210
DASHBOARD_HOST=127.0.0.1
UPLOADS_DIR=./uploads
NODE_ENV=development

# Railway supplies PORT automatically. Do not normally set it for local development.
# PORT=3210
